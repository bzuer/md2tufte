---
import BaseLayout from "../layouts/BaseLayout.astro";
import { listContentPages } from "../lib/content.js";
import { renderMarkdown } from "../lib/markdown.js";
import { buildPageMetadata } from "../lib/metadata.js";

export async function getStaticPaths() {
  const pages = await listContentPages();
  return pages
    .filter((page) => page.slug !== null)
    .map((page) => ({ params: { slug: page.slug }, props: { page } }));
}

const { page } = Astro.props;
const metadata = buildPageMetadata(page);
const html = await renderMarkdown(page.body);
---

<BaseLayout metadata={metadata}>
  <Fragment set:html={html} />
</BaseLayout>
