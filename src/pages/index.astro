---
import BaseLayout from "../layouts/BaseLayout.astro";
import { loadContentPage } from "../lib/content.js";
import { renderMarkdown } from "../lib/markdown.js";
import { buildPageMetadata } from "../lib/metadata.js";

const page = await loadContentPage("index.md");
const metadata = buildPageMetadata(page);
const html = await renderMarkdown(page.body, { title: page.data.title });
---

<BaseLayout metadata={metadata}>
  <Fragment set:html={html} />
</BaseLayout>
