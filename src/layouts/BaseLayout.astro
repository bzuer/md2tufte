---
import "katex/dist/katex.min.css";
import SiteHead from "../components/SiteHead.astro";
import { site } from "../lib/site.js";
import { stylesheetHref } from "../lib/stylesheet.js";

const { metadata } = Astro.props;
const stylesheet = stylesheetHref({ dev: import.meta.env.DEV });
---
<!DOCTYPE html>
<html lang={site.lang}>
  <head>
    <SiteHead metadata={metadata} stylesheet={stylesheet} />
  </head>
  <body>
    <a class="skip-link" href="#content">Skip to content</a>
    <main id="content">
      <article>
        <section>
          <slot />
        </section>
      </article>
    </main>
    <script src="/static/js/main.min.js" defer></script>
  </body>
</html>
